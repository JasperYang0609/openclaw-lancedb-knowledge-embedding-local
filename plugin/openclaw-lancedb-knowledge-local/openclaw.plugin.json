{
  "id": "openclaw-lancedb-knowledge-local",
  "kind": "tools",
  "name": "OpenClaw Local Knowledge Search",
  "description": "Read-only source-cited search over a managed Qwen-local LanceDB index.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "required": [
      "projectRoot",
      "nodePath"
    ],
    "properties": {
      "projectRoot": {
        "type": "string",
        "minLength": 1
      },
      "nodePath": {
        "type": "string",
        "minLength": 1
      },
      "allowedProjects": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,79}$"
        },
        "maxItems": 100,
        "uniqueItems": true
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 30000
      },
      "maxOutputBytes": {
        "type": "integer",
        "minimum": 4096,
        "maximum": 524288,
        "default": 262144
      }
    },
    "additionalProperties": false
  },
  "contracts": {
    "tools": [
      "local_knowledge_search"
    ]
  }
}
