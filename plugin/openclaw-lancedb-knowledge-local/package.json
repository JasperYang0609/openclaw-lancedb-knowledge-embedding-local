{
  "name": "openclaw-lancedb-knowledge-local-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only OpenClaw tool for a managed Qwen-local LanceDB index",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "files": [
    "index.js",
    "src",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check src/search-tool.js",
    "plugin:build": "openclaw plugins build --root . --entry ./index.js",
    "plugin:validate": "openclaw plugins validate --root . --entry ./index.js",
    "test": "node --test"
  }
}
